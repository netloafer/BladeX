# BladeX Proxy 配置模板
# 复制为 .env 并填入真实值：cp config/.env.example config/.env
# .env 已在 .gitignore 中，不会被提交

# ═══════════════════════════════════════════
# 这个文件是怎么被找到、怎么被应用的（2026-08-06）
# ═══════════════════════════════════════════
# 【找到】部署根 = 含 config/.env 的目录，按序查找：
#   BLADEX_HOME → 当前目录及其所有上级目录 → ~/.bladex
# 所以在仓库任何子目录里跑 `bladex` 都能正常工作；全局安装（pip / uv tool）的用户
# 把 BLADEX_HOME 指到部署目录，或直接部署在 ~/.bladex。
# CLI 会切到部署根再干活（否则 data/、logs/ 会落在你当前目录 → 看到一个空库），
# 但你在命令行上给的相对路径仍相对你敲命令的目录。
#
# 【应用】进程环境里已有的同名变量 **压过** 本文件（12 因子应用的常规语义，
# 编排器 compose/systemd/CI 注入的值必须能覆盖镜像里带的文件）。
#
# 但**冲突不会静默**：启动时会把每个"文件里写了、却没生效"的键连值一起
# WARNING 出来（密钥掩码）。两次真实事故（注入预算 200 被残留的 150 顶掉 →
# 记忆静默失效；上游 base URL / API key 改完重启仍读旧值 → 大量 distill_failed）
# 的病根都是**当时看不见**，不是优先级方向本身 —— 所以修的是可见性。
# 遇到"改了 .env 不生效"，先看启动日志里的那段 WARNING，再 `unset` 掉残留的 export。
#
#   BLADEX_ENV_PRECEDENCE=file  # 反过来：本文件压过环境变量
#   BLADEX_ENV_KEEP=A,B         # precedence=file 时，只让个别键保持"环境优先"
# 这两个键与 BLADEX_HOME 一样，只能从环境读——本文件不能改写"自己怎么被加载"。

# ═══════════════════════════════════════════
# 客户端 key 验证（BladeX 发行的 key，可开关）
# ═══════════════════════════════════════════
# 是否开启：true=必须带有效 key，false=不校验放行（开发时方便）
export BLADEX_AUTH_ENABLED="false"

# key 列表，|| 分隔，格式：key||label||key||label
# 生成新 key：python3 -c "import secrets; print('bladex-' + secrets.token_urlsafe(24))"
export BLADEX_CLIENT_KEYS="bladex-your-key-here||device-name"

# ═══════════════════════════════════════════
# 上游模型路由
# ═══════════════════════════════════════════
export BLADEX_UPSTREAM_MODEL="openai/your-model-name"
export BLADEX_UPSTREAM_API_BASE="https://your-api-endpoint.com/v1"
export BLADEX_UPSTREAM_API_KEY="your-api-key"

# ═══════════════════════════════════════════
# 服务 + 存储 + 硬规则
# ═══════════════════════════════════════════
export BLADEX_HOST="127.0.0.1"
export BLADEX_PORT="38080"
export BLADEX_REDIS_URL="redis://127.0.0.1:6379/0"
# Redis 命名空间三旋钮（MQ-A38）：同一台机器起第二个 BladeX 实例（演示 / 冷安装验证 / 排障）时，
# 只改端口与 db **不够**——stream 与消费组同名就会把 live 的轮次静默偷走。第二实例必须三项都换，
# 并把 BLADEX_REDIS_URL 指到另一个 db（如 .../9）。
export BLADEX_REDIS_STREAM="bladex:turns"
export BLADEX_REDIS_GROUP="bladex-workers"
export BLADEX_REDIS_CONSUMER="worker-1"
export BLADEX_ROCKSDB_PATH="data/bladex_hub"
export BLADEX_HARD_RULES="MUST respond in the same language as the user's message||NEVER use emojis in responses"


# ═══════════════════════════════════════════
# 路由（Phase 1 路由规格卡：配置驱动确定性路由 + 可选 LLM 裁判）
# ═══════════════════════════════════════════
# 路由总开关：true=按流水线选模型，false=单一上游直转（回归）
export BLADEX_ROUTE_ENABLED="false"
# 路由配置文件（模型列表 + upstream + 三条策略）；见 config/routing.toml.example
export BLADEX_ROUTING_CONFIG="config/routing.toml"
# auxiliary 内部调用（上下文压缩/任务列表压缩等）强制走的便宜档（默认 weak）
export BLADEX_AUX_TIER="weak"
# 可选：路由开着但不可用时是否拒绝启动（fail-fast），默认 false
export BLADEX_ROUTE_STRICT="false"
# 参数兼容策略：proxy 转发时 Router 全局 drop_params=True（router_sdk.py 顶部硬编码）--
# 按目标模型能力 drop 它不支持的参数（如 reasoning_effort--Hermes/Cursor/Codex 等
# 编程工具常发，glm-5.2/doubao/deepseek 等 ARK 模型不支持 -> 否则 502）。
# 通用适配任意 agent × 任意模型：支持该参数的模型（如 o1/gpt-5）保留，不支持的 drop，
# 无需维护白名单。若要关掉（让不支持的参数直报错），改 router_sdk.py 顶部 drop_params。
# Router 转发层的日志详略（DEBUG/INFO/WARNING/ERROR，默认 INFO）。
# 上游 SDK 的日志由 BladeX 接管：署名统一成 Router、摘掉它自带的重复 handler。
# 排查"这轮到底发给了谁、带了什么参数"时设 DEBUG。
export BLADEX_ROUTER_LOG_LEVEL="INFO"


# ═══════════════════════════════════════════
# Embedding 后端（可选化，2026-07-26；见 embedding 后端评估记录）
# ═══════════════════════════════════════════
# 【推荐】结构化配置走 routing.toml [embedding] 段（见 config/routing.toml.example，
#   与 [distill] 同先例）；下面这批 env 是覆盖/回滚通道——显式设置时压过 toml。
# 后端：local（默认，零回归，模型不出机）| api（经 Router 调线上 embedding）
#       | proxy（单机共享模型：proxy 侧载模型并经 /v1/embeddings 服务，
#                consolidator 侧调它、不自载 -> 单机内存减半）
# ⚠️ 切换后端/模型 = 换向量空间：必须先停两进程跑 python scripts/reembed_index.py，
#    否则 Memory Index model_id 不变量拒绝启动（consolidator）/ 禁用向量检索（proxy）。
# ⚠️ api 档隐私：全部记忆内容（每条 fact + 每轮 query）外发给 embedding 供应商；
#    ADR-0021 敏感层启用时 api 档被强制回 local（BLADEX_ROUTE_STRICT=true 则拒启动）。
export BLADEX_EMBED_BACKEND="local"
# local 档模型（空 = BAAI/bge-small-en-v1.5，384d/0.07GB，英语优先、开箱即用）。
#   七档推荐模板 + 能力说明见 routing.toml.example [embedding] 段（bge-en 三档 /
#   多语 MiniLM-L12 / jina-zh / mpnet / e5-large）。模型缺失时启动自动下载，
#   HF 主站不可达自动切 hf-mirror.com（显式设 HF_ENDPOINT 则尊重你的设置）。
#   注：已有 Memory Index 库且未显式配置时沿用库内已盖章模型（升级不废现有向量空间）。
# api 档模型（Router 格式 provider/model，必填）：如 openai/text-embedding-3-small、doubao-embedding
# export BLADEX_EMBED_MODEL=""
# api 档 endpoint + key（key 只放 env，不入 git）
# export BLADEX_EMBED_API_BASE=""
# export BLADEX_EMBED_API_KEY=""
# proxy 档（单机共享模型）：proxy 侧加载模型并经 /v1/embeddings 服务，
#   consolidator 侧 HTTP 调它、不再自载 —— 推荐在 routing.toml [embedding] 段配置。
#   key 必须是**纯 key 值**（不是 BLADEX_CLIENT_KEYS 的 "key||label" 列表格式）；
#   仅 BLADEX_AUTH_ENABLED=true 时需要。
# export BLADEX_EMBED_PROXY_URL="http://127.0.0.1:38080"
# export BLADEX_EMBED_PROXY_KEY="bladex-xxxxxxxxxxxx"
#   等待 proxy 就绪的超时秒数（run_proxy.sh 先拉 consolidator，故需重试等待；默认 180）
# export BLADEX_EMBED_PROXY_WAIT_S="180"
# query 嵌入 LRU 容量（api/proxy 档降网络往返；0 = 关闭）
# export BLADEX_EMBED_QUERY_CACHE="256"
#   /v1/embeddings 调用归因日志汇总窗口秒数（默认 60）。每个
#   (caller, purpose, input_type) 组合首次出现立刻记一条 embed_caller_seen，
#   之后每窗口一条 embed_requests_summary；逐条明细在 debug 级。
# export BLADEX_EMBED_LOG_WINDOW_S="60"
#   调用方名字（consolidator 侧写进 X-BladeX-Caller；默认取 build_embedder 的 role）
# export BLADEX_EMBED_CALLER="consolidator"

# ═══════════════════════════════════════════
# L2 蒸馏模型（ADR-0018 §3.6）
# ═══════════════════════════════════════════
# 三级优先级：env BLADEX_DISTILL_MODEL > config/routing.toml [distill].model > 自举
# （从模型池按 tier weak->medium->strong 取首个可用者，首次启动写回 toml）。
# 默认空 -> 走 toml [distill].model（已 pin openai/deepseek-v4-flash）；一般不用设。
# export BLADEX_DISTILL_MODEL=""

# ── 🔴 这两个参数是**一对**，改一个必须想到另一个（MQ-R2，2026-08-17）──────────
# 耦合关系：放大输出预算 -> 生成变长 -> 撞死超时 -> 蒸馏静默返回空结果。
# 这一形态咬过三次：08-14 bench 排空卡 91% 一小时、08-16 全量重建 11.3% 轮次
# 静默零事实（中断守卫阈值 0.5 拦不住慢性失血）、08-17 守护进程排空完全停摆。
# 三次都只是在当次命令行临时带参数，从未进默认配置。
#
# 现在 TIMEOUT_S **不配就随 MAX_TOKENS 自动推**（90s / 1k tokens，下限 30s，
# 见 distillation.py `default_distill_timeout_s`），所以正常情况只需要配上面那个。
# 下面这行是覆盖通道：上游特别慢、或做离线全量重建时手动调大。
#
#   MAX_TOKENS=512（历史默认） -> 约 46s
#   MAX_TOKENS=2048（本机 live）-> 约 184s（实测 180s 稳定：08-16 重建 + 08-17 排空）
#
# MAX_TOKENS 定小的代价是**确定性丢事实**（MS-15：输出被 length 截断），
# 不是"省钱"——蒸馏产出本来就短，预算只是天花板。
export BLADEX_DISTILL_MAX_TOKENS="512"
# export BLADEX_DISTILL_TIMEOUT_S="180"

# 蒸馏并发路数（1 = 串行）。`bladex sync` 与 CLI 拉起的 consolidator 守护进程
# 共用这一个默认值——2026-08-22 之前两条路各有一个（sync 4 / 守护进程 1），
# 结果是守护进程串行蒸馏 5–26 轮/小时、Memory Index 积压 720 轮不降。
# 上游限流（429）时调小；调大之前先看 logs/consolidator-*.log 有没有 429。
export BLADEX_DISTILL_CONCURRENCY="4"

# ═══════════════════════════════════════════
# 接入指引：推荐配置 X-Agent-ID / X-Session-ID header
# ═══════════════════════════════════════════
# 这两个 header 是"零改代码、需配置"的最小推荐集，让 BladeX 精确区分
# 哪个 agent、哪个会话发来的请求，而非依赖脆弱的指纹推断。
#
# 配置方式（以 Hermes / Codex / 任何 OpenAI 兼容客户端为例）：
#   在发往 BladeX proxy 的请求里加两个 header：
#     X-Agent-ID: codex        （或 hermes / claude-code / cursor 等）
#     X-Session-ID: <唯一会话标识> （如 UUID，或 agent 自己的 session id）
#
# 不配也能用（proxy 会从 system prompt + tool 签名被动识别 agent），
# 但 profile 级区分（如 Hermes accept vs default）需要配 X-Agent-Profile。
#
# Profile 区分（X-Agent-Profile header）：
#   同一 agent 不同配置文件是不同 agent，策略管理分别对待。
#   例：hermes 的 accept 配置 → X-Agent-Profile: accept → agent_id = "hermes:accept"
#       hermes 的 default 配置 → X-Agent-Profile: default → agent_id = "hermes:default"
#   不配 → agent_id 不带 profile 后缀（如 "hermes"），子请求通过会话粘性继承。

# ═══════════════════════════════════════════
# 上下文装配（ADR-0019；取代 ADR-0016 CAP，BLADEX_CAP_* 名仍兼容映射）
# ═══════════════════════════════════════════
# 按任务单元的证据生命周期管理上下文：closed 单元的巨型 tool 结果降解为占位摘录
# （零 LLM，结论即蒸馏），超阈值再做单元摘要。关闭 = 纯叠加注入（向后兼容）。
export BLADEX_ASSEMBLY_ENABLED="true"
# 装配只对清单内的 agent 开（逗号分隔 agent_id 或 base；`*`=全开、空=全关）。
# 2026-09-03 拍板 e：默认只开 claude-code——其它 agent live 全在掉字（MQ-CA4/CA6），
# 代价 = 非 CC 上游 token 回升 ~2.4×，有意付；默认值真身 bladex_core/flags.py。
export BLADEX_ASSEMBLY_AGENTS="claude-code"
# 触发单元摘要的消息数阈值
export BLADEX_ASSEMBLY_MSG_THRESHOLD="30"
# 保留最近 N 个任务单元原文（含 tool call/result 配对）
export BLADEX_ASSEMBLY_PRESERVE_UNITS="3"
# 单元摘要最大字符数
export BLADEX_ASSEMBLY_SUMMARY_MAX_CHARS="1000"

# ═══════════════════════════════════════════
# 热路径预算与记忆机制开关（ADR-0026 / ADR-0027 §5.4）
# ═══════════════════════════════════════════
# 注入热路径（认身份 + 检索 + 注入）延迟预算。超预算静默降级为"只注硬规则"，
# 故这个值定小了 = 记忆静默失效。默认 200ms 是 2026-08-04 实测定的：软打分 +
# 有限跳开启后，150ms 下 18% 的轮次超时，且超时值全在 151–153ms（只超 1–3ms）。
export BLADEX_HOTPATH_BUDGET_MS="200"
# 注入块字符预算。2026-08-14 随注入条目默认 3→15（LongMemEval 基准标定：
# TOPK=3 48% / TOPK=15 68%，E6.4 砍配额实测 -20 点）连带 1800→4000。
# 🔴 两者必须匹配：预算装不下条目时③平面**整段砍**（budget_dropped 告警可 grep）。
export BLADEX_INJECT_MAX_CHARS="4000"
# 注入条目数上限（默认取 core MAX_PREFETCH_K=15，一般不用设；调小回旧行为）
# export BLADEX_INJECT_TOPK="15"

# 记忆机制开关（ADR-0024/0025/0026 统一改造，2026-08-04 起**默认开启**）。
# 默认值权威在 packages/bladex-core/bladex_core/flags.py，与本文件由测试对账。
# 任一项设 0 即回滚到旧行为（关闭后注入块逐字一致，有测试钉死）。
#
#   SOFT_SCORING   检索软打分：dense + 关键词 + 实体 + 重要性 + 时近 五信号融合
#   HOP_EXPAND     有限跳：取代关系反向替换 / 同 Matter 兄弟 / 父事扩展
#   PROFILE_CARDS  画像卡：User 画像与 Agent 习惯的被动捕获与渲染
#
# （BLADEX_INJECT_INDEX_RECALL / BLADEX_INJECT_PLANES 已于 2026-09-03 S1 删除：
#  主动注入检索路径整体退役，注入面只剩硬规则；记忆经 bladex_memory_search 工具面取。
#  下面三个仍在——消费点不在注入路径：SOFT_SCORING / HOP_EXPAND 门 MemoryIndex.search
#  （工具面走它），PROFILE_CARDS 门写侧画像捕获。）
# （BLADEX_ITEM_BOUNDARY 已删除——2026-08-15 拍板默认关的条目边界，2026-09-03 S4
#  随主动注入检索路径一起退役。）
export BLADEX_SOFT_SCORING="1"
export BLADEX_HOP_EXPAND="1"
export BLADEX_PROFILE_CARDS="1"
# （BLADEX_ATTRIB_L0 已删除——ADR-0024 §4.5 L0 同单元同属，默认关、从未翻默认，
#  2026-09-03 S4 连函数一起删；素材在 git 历史。）

# MQ-S27 硬分流（2026-08-20 拍板）：lane:profile / lane:tool 的 fact（含
# item_kind=PROFILE_OBS）不进 Matter 归属、不建边——profile 走画像原料通道，
# tool 类留 KB 检索不挂卡。此前 296 条画像/规则 fact 散挂任务卡（「小黑称呼」
# 挂了四张卡）。0 = 关（归属循环回到改动前）。manual 手动映射永远压过本开关。
export BLADEX_LANE_HARD_SPLIT="1"

# G12.2 D1 范式（ADR-0031 §3；算法 = 决策表 v2）：默认延续 + 活跃档案窗口。
# R1/R2/R4 直挂零 LLM，R5 落回五层管线兜底 + taskstate 台账钉首轮集合。
# ✅ 2026-08-21 翻默认 0 → 1：误延续尺前后对照通过（CONT 层判 116 条 BOTH=0.0%、
# R2 长链污染仍为「无」、其余层逐字零回归），live 21 小时 79 条层判决两个失败
# 计数全 0。完整判据与「这份读数不证明什么」见 flags.py 该键注释。
# 回滚通道：设 0 即退回五层管线原行为。依赖 BLADEX_ATTRIB_CONTINUATION=1。
export BLADEX_TASK_STATE_D1="1"

# GM-1 对话延续信号进候选（MQ-S13，2026-08-18）：
# 「延续(TAIL_CONTINUATION) ∧ 无新主体」→ 把上一轮 fact 所属的 Matter 加进候选池。
# 🔴 只加候选、判定仍由 L4 做 —— 与 ATTRIB_L0（确定性合并）不是一类东西，
# 故默认开：最坏情况是多送一次裁决，不是把误合并直接落库。
# 置 0 = 回滚通道（候选池逐字回到改动前）。
export BLADEX_ATTRIB_CONTINUATION="1"
# GM-2 按主题键反查候选 Matter（MQ-S11，2026-08-18）：
# 归属候选此前只有纯向量一条通路；本项补的是向量散开的那一段（同一对象不同动作）。
# 带两道硬门（判别力门 + 单键永不放行），否则泛词 `bladex` 一个键就命中 57 张卡
# = MS-16 吸尘器从合并侧搬到候选侧。同样只加候选、判定仍由 L4 做。
export BLADEX_ATTRIB_KEY_RECALL="1"

# 第二批机制开关（ADR-0028 §4 / E2.1，2026-08-05 起默认开启）。
# 这批的共同形态是"代码早就写完了，只是从来没人把开关打开"——与第一批同一类腐化。
#
#   SUPERSEDE_ENABLED  去重合并 + 强度评分 + 冲突覆盖：
#                      同取代键(scope, subject, attribute)同义 → 旧条 strength+1 不新增行；
#                      同键异值 → 旧条 t_invalid + superseded_by + SUPERSEDES 边（旧条保留，as-of 可见）
#   MATTER_LIFECYCLE   Matter 卡 lifecycle 事件（会话事件折叠进卡，不产出为条目）
export BLADEX_SUPERSEDE_ENABLED="1"
export BLADEX_MATTER_LIFECYCLE="1"
# （BLADEX_FILE_REF_ENABLED 已删除——M1-2/拍板 3 退役的 file_ref 通道，2026-09-03 S4
#  连同僵尸开关一起清；可检索形态由 BLADEX_FILE_INDEX（E7.1）接管。）
# （BLADEX_KEYWORD_CHANNEL 已删除——三段式卡 T3c：旧 substring 通道随 E6.2
#  删除后 flag 留成僵尸零消费方；词法路 = FTS5，无条件参与融合。）

# 融合 entity 通道的热门实体衰减系数（三段式卡 T3b，2026-08-10）。
# decay = 1/(1+coef·(N-1)²)，N = 实体关联 fact 数；'bladex' 这类全项目高频实体
# 加权趋零防霸榜。随 BLADEX_SOFT_SCORING 整体开关（不另立总开关）。
export BLADEX_ENTITY_DECAY_COEF="0.001"

# 蒸馏 v4 两级路由（M1-2）：先分流（话语 / 规则文件 / 粘贴物），
# 话语路才走「一轮一次统一调用」——user + assistant 同包 + 上下文摘要 + 时间锚。
# 修的是两件事：① v3 三条通道互不知情，产出大量"用户询问 XXX"而丢掉真正的结论；
# ② 剥完信封仍超长的内容几乎都是文档而非话语，切成六段去走"用户陈述蒸馏"就是投毒。
# 置 0 回落 v3 三条独立流水线（行为逐字不变，回滚通道）。
export BLADEX_DISTILL_V4="1"

# 蒸馏产出语言（M1-1 / 拍板 2）。默认中文。
# 为什么是配置量而不是"跟随输入"：跟随输入时同一轮的 user 通道蒸中文、
# conclusion 通道蒸英文，ZH/EN 同义对 cosine 0.8639 < 判重阈值 → 同一事实存两份，
# 而中文 query 只捞得回其中一份。可选 zh / en。
export BLADEX_DISTILL_LANG="zh"

# ═══════════════════════════════════════════
# 写入时裁决（M2 / 复核第 2 层：模块 2/3 的统一解）
# ═══════════════════════════════════════════
# novelty 阈值独自决定"这条该不该入库"是行不通的：e5 在本库的噪声底就是
# 0.816–0.93，阈值定高了漏网（带日期的近重复变体互相看不见）、定低了误合并。
# 而 live 库实测：冲突对手方在新事实写入时刻的近邻排名 3/4 在 **top-1** ——
# 向量早就把双方送到了同一张桌子上，只是桌边没坐判定者。
#
# 所以：novelty 降为"只拦完全重发"，0.90 以上的邻居打包交便宜档模型判
# ADD / UPDATE(旧条 t_invalid+superseded_by) / NOOP(旧条 strength+1)，
# 决策写 judgment 台账（rebuild 重放零 LLM）。成本实测 ≈ 9 次/天。
# 置 0 回落旧形态（supersede 精确键 + 冲突检测只 log）。
export BLADEX_ADJUDICATE_ENABLED="1"

# 全量重建时按 judgment 台账重放取代关系（fact 的 t_invalid / superseded_by）。
# 为什么默认开：取代关系是重建产物的一部分，却既不来自会话数据（要 LLM 判断）也不来自
# 管理事件（不是用户操作）—— 不重放 = 每次全量重建静默丢失一类**已付费**的信息
# （2026-08-31 实测：1124 条同键并存里 237 条 = 21.1% 出自这里）。
# 置 0 回到旧行为，并兼作 A/B 仪器（`why_no_supersede --batch` 应回到旧读数）。
export BLADEX_SUPERSEDE_REPLAY_ENABLED="1"

# novelty：只拦完全重发（重试/重发同一条）。0.95→0.98 的语义变化见上。
export BLADEX_NOVELTY_THRESHOLD="0.98"
# 进裁决包的邻居相似度下限。live 库实测：0.85 → 92% 写入触发、平均 35.8 邻居（太宽）；
# 0.90 → 62% 触发、平均 4.5 邻居，正好一个裁决包。
export BLADEX_ADJUDICATE_MIN_SIM="0.90"
# 裁决包邻居数上限。**不是 5**：跨语言冲突对实测排在 top-8，k=5 会整个漏掉。
export BLADEX_ADJUDICATE_TOPK="10"
# 一次裁决调用最多打包多少条候选。分块的意义是**限制爆炸半径**：
# 单块解析失败只让该块降级 ADD，不影响其它块。
# 25 是保守起点，未经真实流量标定（2026-08-08 立）。
export BLADEX_ADJUDICATE_CHUNK="25"

# 一次嵌入调用最多送多少条文本。此前候选嵌入是一次性整批，全量重建把 6 万段话语
# 塞进一个调用 ⇒ IPC 后端必然 120s 超时、期间零进度（"在跑"与"卡死"不可区分）、
# 且打不断。分块后每块报一次 rate/eta（`consolidate_embed_progress`）。
# 512 未经标定，按实测 rate 调。
export BLADEX_EMBED_BATCH="512"
# 一轮提炼里降级成 ADD 的**候选比例**达到该值 → 判为裁决侧上游中断：本轮不写事实、
# 不标记消费，退避重试。与 BLADEX_DISTILL_OUTAGE_ABORT_RATIO 同型同默认值。
# 为什么要有它：裁决失败是降级不抛的（`_all_add` 整块判 ADD），而 ADD 是合法判决——
# "上游断了"和"这批确实都是新事实"在下游长得一样，消费标记照打，当场制造同键并存
# （2026-08-31 全库读数实测 46 条）。0 = 关闭守卫。
export BLADEX_ADJUDICATE_OUTAGE_ABORT_RATIO="0.5"

# ═══════════════════════════════════════════
# 三时钟生命周期（M3 / 复核 5.9 用户拍板）
# ═══════════════════════════════════════════
# 三个判据：创建钟（太久 → 可能无用）、更新钟（太久不更新 → 不再活跃）、
# 相关钟（太久无命中 → 不再有相关性）。相关钟此前**完全缺失**，M3-1 才补上。
#
# Matter 的 2×2 出口矩阵（H1 的解）：
#                 近期有命中          久无命中
#   近期有更新     active（正常）      在写从不被用 → 过度采集审计信号
#   久无更新       dormant（保留可召回）auto-close 候选（双钟停摆）
#
# 🔴 这三个数是**起步值不是结论**（拍板 6：先立观测、真实数据标定后调）。
export BLADEX_CLOCK_STALE_UPDATE_D="14"
export BLADEX_CLOCK_STALE_HIT_D="30"
export BLADEX_CLOCK_PROVISIONAL_MAX_D="30"

# 🔴 观测期护栏：last_hit_at 全库覆盖率低于此值时**只 log 不动状态**。
# 理由是实测过的事故：07-28~08-05 注入中断期间全库零命中，若当时已有
# "30 天无命中即退场"，就会发生**系统故障触发的大规模误杀**。
# 钟只有在喂它的事件干净时才可信；覆盖率就是"这个钟有没有在被喂"的度量。
# 注意：M3-1 刚上线时覆盖率必然是 0，全量重建后又会清零 ——
# "上线后一段时间只 log"是设计使然，不是没生效。
export BLADEX_CLOCK_MIN_COVERAGE="0.5"

# （MS-6 钉卡自愈 BLADEX_PIN_COOLOFF_D / PIN_MISS_MAX 已随 2026-09-03 S1 删除。）

# 文件内容索引（ADR-0028 §5 / E7.1）：读写类工具读到的文件正文 → 摘要 + 关键词，
# 建**独立**检索通道（配额 1，不挤占散点召回位）。取代零信息量的裸路径 file_ref。
export BLADEX_FILE_INDEX="1"

# Prompt Cache TTL 感知（ADR-0028 §2/§3）：
#   温热（同模型 + 距上次转发 < 该模型 cache_ttl_s + agent 没自己压缩过）
#     → 全量转发 + 复用上一轮冻结的降解/裁剪计划，**不新增**任何改写（保 cache）；
#   冷（模型换了 / TTL 过期 / 首轮）
#     → 装配正常跑 + 冷启相关性裁剪（长会话里问一个简单问题不再拖着整段历史）。
# 每模型 TTL 配在 config/routing.toml 的 [[models]].cache_ttl_s（默认 300，0=无 cache）。
export BLADEX_CACHE_TTL_AWARE="1"

# 重要性遗忘门槛（ADR-0028 §4 / E2.1）：importance 低于此值的条目**退出召回**。
# 注意语义：遗忘 = 退出召回，**不删数据**——meta/Memory Hub 全保留、as-of 可查、重建等价性
# 不受影响（G6）。0 = 不过滤。
#
# M0-8（复核 G3）+ B5 口径订正（2026-08-06 拍板）：默认 0，**且永久退役**。
# importance 的三个动态输入曾全部断粮（strength 断在合并从未运转、ref_count 断在
# 注入长期只注硬规则、只剩时间半衰减在动），此时开门槛等于按年龄无差别遗忘。
#
# 🔴 三时钟（M3）落地后**也不要重开这个门槛**：遗忘只有一个机制——三时钟
# （更新钟 × 相关钟 + kind 豁免表）；importance 只作排序弱先验与 dashboard 信号。
# 两个遗忘机制并存就要额外定义优先级与冲突消解，那正是"没人说得清谁把数据吃了"的温床。
export BLADEX_MIN_IMPORTANCE="0.0"

# （Matter 钉卡门 BLADEX_MATTER_PIN_MIN / PIN_MARGIN / PIN_SOLO_MIN 已随 2026-09-03 S1 删除：
#  唯一消费点是三平面②平面钉卡；标定素材 data/bench_batched/t3d_*_calibration.txt。）

# T3-A（检索侧 16 点收复，2026-08-15）：profile_obs 检索可达性。
# 此前融合配额层整类丢弃（quota=0），而"加入/开始/购买 于 DATE"型时间锚大量
# 蒸成 profile_obs → temporal 问题的答案结构性不可达（T1 归因 11/18 错题）。
# 改为限额参与（top-k 内最多 N 条）+ 排序折价（融合总分乘数，防挤掉同等相关的
# assertion/lesson）。QUOTA=0 即回退旧行为；DISCOUNT=1.0 即不折价。0.85 为
# 保守起步值 [标定]，由 retrieval_eval 内部尺子守回归。
export BLADEX_QUOTA_PROFILE_OBS="2"
export BLADEX_PROFILE_OBS_DISCOUNT="0.85"

# 同义折叠的 cosine 阈值。
# 08-20 读数（内部基准 channel-votes-20260820）：e5 排进前 5 却没进注入的
# 候选里 80.7% 死在折叠，且 0.92 正埋在 fusion.py 自己声明的噪声底 0.88–0.93 里
# —— 据此把默认值提到过 0.97。
# 🔴 08-21 共享库 A/B 终验（longmemeval-fold-ab-20260821-064603.md）：
#    0.92 → 72.0% ／ 0.97 → 68.0%。−4pp 不显著（McNemar p=0.727，discordant 仅 8 题），
#    但同样无证据支持改动 ⇒ **默认值回退 0.92**（无证据不改默认）。
#    机制保留：设 "0.97" 即复现实验档。G13.1 未收口，待补 A/A 噪声底对照。
export BLADEX_FOLD_COSINE="0.92"


# GM-1「无新主体」门槛：本轮 user 文本相对上一轮（user + assistant 回复）新增的
# 主体信号数 ≥ 本值 → 判为引入新任务、不进候选。仅在 BLADEX_ATTRIB_CONTINUATION=1
# 时有意义。🔴 这个值不承重（候选只送裁决）：探针扫 1→12 收益列全程高于风险列且
# 不交叉（14.9%→18.0% vs 6.5%→2.3%），结论不是阈值的产物；调大只是多送几次 L4。
export BLADEX_ATTRIB_CONT_NEW_SUBJECT_MAX="3"

# GM-2 判别力门：主题键出现在超过 `本值 × 库内可链接 Matter 数` 张卡上 → 判为泛词，
# 不参与按键反查（下限 2 张）。仅在 BLADEX_ATTRIB_KEY_RECALL=1 时有意义。
# 🔴 分母随库走而非绝对数：同一个"出现在 5 张卡上"在 20 张卡的库里是泛词、
# 在 5000 张卡的库里是强标识符（绝对阈值当门槛 = MQ-S1 清查的设计模式）。
# 0.05 [标定]：当前库 103 卡 → 门槛 5，挡掉 bladex(42)/skill.md(19)/ollama(14)；
# 而 903 个键里 732 个只出现在 1 张卡上，代价很小。待真实读数复标。
export BLADEX_ATTRIB_KEY_DF_RATIO="0.05"

# 生命周期重算 job（"睡眠巩固"，ADR-0028 E2.4）的最小间隔（秒）。
# consolidator 空闲轮触发，全量重算 importance 让半衰减项真正随时间生效。
export BLADEX_LIFECYCLE_INTERVAL_S="21600"

# fp: 指纹会话桶的时间窗切分（MQ-S9 / G12.2-pre，2026-08-20 拍板 4h）：
# 同桶相邻请求间隔超过此秒数 → 后续轮次挂新纪元后缀，终结"一个开场白指纹
# 撞出 8 天/474 轮一个 session"的假会话桶。0 = 关闭（回旧撞桶行为）。
# 只作用于 fp: 桶；显式 X-Session-ID 永不切（那是 agent 自己声明的边界）。
export BLADEX_SESSION_FP_WINDOW_S="14400"

# 会话前缀候选槽数（V-C1 / MQ-S47，2026-08-28）：每个 session_prefix 保留最近
# 几条 (prefix_hash, msg_count) 供 prefix 变化检测遍历匹配。1 = 退回旧单槽行为。
#
# 为什么必须 >1：agent 会在同一个 session_prefix 下混跑多路流量——claude-code
# 实测两路（主会话 msg_count 递增 2→173、与 3 条消息的小请求交替）。单槽被两路
# 互相覆盖，双方都拿对方当基准 ⇒ 两跑 54 次 hub_prefix_changed 里 53 次假阳性、
# 真阳性 0，且它一度是日志里唯一的 warning（通道被占满）。
# 取 4 = 主会话 1 + 小请求 1 + 2 槽余量。
export BLADEX_PREFIX_SLOTS="4"

# 索引碎片自维护阈值（MQ-R1，2026-08-17）：facts 向量表的碎片（datafile）数超过
# 本值，就在 consolidation pass 收尾压一次。0 = 关闭这条自维护（回归通道）。
#
# 🔴 它防的事故已经兑现过两次：LanceDB 追加写是**一行一碎片**，MS-14（08-09）
# 手工压过一次但没做自维护，于是 08-16 一次全量重建把 1619 条 fact 写成 1619 个
# 碎片 → dense 检索 6462ms → 每轮撞热路径 deadline → 降级只注硬规则 →
# **注入面空转了一个月**（2952 轮里只有 10 轮有注入记录）。
#
# 这个数是从预算推的，不是拍的：search ≈ 410ms + 3.63ms × 碎片数（08-17 两点
# 线性 + 外推校验），800ms 预算减掉 410ms 固定底与 22ms embed/matter，
# 余量 368ms ÷ 3.63 ≈ 100 个碎片 ≈ 60 轮。
# ⇒ **改 BLADEX_HOTPATH_BUDGET_MS 时这个数要跟着重算。**
export BLADEX_INDEX_MAX_FRAGMENTS="100"

# ═══════════════════════════════════════════
# 蒸馏中断守卫（2026-08-05 事故驱动）
# ═══════════════════════════════════════════
# 一轮 Memory Index 提炼里蒸馏调用失败率达到该比例 → 判为上游中断：本轮**不标记消费、不写 Memory Index**，
# 退避到下轮重试（失败不进台账，重试零成本）。0 = 关闭守卫，回到旧行为。
# 为什么要有它：蒸馏失败是降级不抛的（返回空结果），所以"上游断了"和"这批本来就没
# 事实"在提炼侧长得一样，而消费标记是无条件打的 —— 上游 DNS 断掉那次，consolidator
# 以 30 turn/分钟把积压全部标记成已消费且零事实，只能人工 --unconsume 捞回。
export BLADEX_DISTILL_OUTAGE_ABORT_RATIO="0.5"

# 单轮蒸馏失败的重试上限（MS-1 / 复核 D4）。
# 守卫（上面那条）管"整批中断"；这条管**单条轮次**——此前失败轮照常被标记消费，
# 那一轮的事实就永久丢了。现在失败轮不消费、下轮重试（失败不入台账，重试零成本），
# 超过本上限才照常消费并打 index_rebuild_distill_retry_exhausted 告警。
#
# 计不计次要看失败的**种类**（队列不许因个别坏轮停摆，同时断线不许烧积压）：
#   parse 失败（响应拿到了、内容用不了）→ 上游活着、问题在这条输入上 → 计次，
#     超限放行。哪怕整批都是这种失败（走 outage 分支）也照样放行——否则积压
#     尾部剩几条永久坏的轮次就会把整条队列堵死。
#   call 失败（连不上/超时/认证/配额）→ 上游的问题，与这条轮次无关 → **一次都不计**。
#     计了就等于"断线 N 分钟后开始把好数据当坏数据丢掉"（2026-08-05 事故形态）。
# 0 = 关闭重试，回到旧行为（失败也照常消费）。
export BLADEX_DISTILL_RETRY_MAX="3"

# 词法通道 bigram 影子表（二字中文词）单次返回上限（M0-5）。**默认 0 = 关闭。**
# 这是一条被检索评估集**否掉**的机制：前提"二字词在 trigram 上零命中"为真
# （FTS 层面 0 → 11/16/4 命中），但"补一条 bigram 路能改善端到端检索"不成立——
# 三种接法在真实评估集上逐一实测，recall@10 全是净负（0.430 → 0.413 / 0.430 / 0.396）。
# 原因：RRF 只看是否在通道里出现，2-gram OR 匹配来的低精度候选哪怕排在末尾，
# 也会拿到不可忽略的融合分，把 dense 的好结果挤出 top-10。
# 机制与影子表保留（写侧照常维护），设 >0 即可打开；留待 MS-9 融合权重标定后重估。
export BLADEX_FTS_BIGRAM_LIMIT="0"

# consolidator 侧漏斗指标端点（M4-2）。**默认 0 = 不启动。**
# 记忆漏斗横跨两个进程，两端各自暴露 /metrics（2026-08-06 拍板）：
#   proxy       :BLADEX_PORT/metrics   → 召回 / 注入 / 命中回写（读取侧）
#   consolidator :本端口/metrics        → 候选 / 蒸馏 / 判重 / 裁决 / 入库（写入侧）+ 库存 KPI
# 各归各的好处是"哪半边没数"一眼可见，不必经 P2 中转（中转层本身会成为一个
# 可能坏掉且难以分辨的环节）。看全链用 `bladex status --traffic`。
# 只监听 127.0.0.1（不鉴权的观测面，绝不听 0.0.0.0）。
export BLADEX_CONSOLIDATOR_METRICS_PORT="0"

# ── Memory Flash（ADR-0032 §5；文件树由 bladex-flash 维护进程写，模块门 BLADEX_MODULE_FLASH）──
# （BLADEX_FLASH_RENDER / BLADEX_FLASH_MATTERS 已于 2026-09-03 S5 删除：ADR-0031 时代
#  consolidator 侧老渲染器的两个旋钮，默认关、live 未设、渲染器代码已删。）

# ── Flash 保鲜（贵在精：目录窗口滑出即回收；含用户手写 *.local.md 的目录跳过）──
# 账本并发标注窗口（秒）：另一写者在窗口内动过激活账本 ⇒ 注入头提示一行；
# 0=关。写冲突硬保护是 rev 乐观锁（bladex_ledger_update 的 rev 参数）。
export BLADEX_LEDGER_COAUTHOR_WINDOW_S=1800

export BLADEX_FLASH_SESSIONS_PER_PROJECT="10"
export BLADEX_FLASH_PROJECTS_PER_AGENT="10"
export BLADEX_FLASH_PROJECT_ACTIVE_DAYS="30"
export BLADEX_FLASH_AGENT_RETIRE_DAYS="90"
# Flash 根目录（默认 <仓库>/data/bladex_flash）。想让它出现在你顺手能打开的地方，
# 改这里即可——它不进备份关键路径。
# export BLADEX_FLASH_PATH="data/bladex_flash"

# ── V-A1 模块开关（ADR-0032 §2.1；默认值单一真相源 = bladex_proxy/modules.py）──
# Router 必选无开关（配 BLADEX_MODULE_ROUTER 会拒启动）。默认形态 = 生产形态
# （v5 四模块 2026-09-02 翻默认开，task-modules-default-on-20260902.md；=0 回滚）：
# BLADEX_MODULE_INJECT=1
# BLADEX_MODULE_SENSITIVITY=1
# BLADEX_MODULE_ASSEMBLY=1
# BLADEX_MODULE_LEDGER=1
# BLADEX_MODULE_FLASH=1
# BLADEX_MODULE_TOOLFACE=1
# BLADEX_MODULE_INTERCEPTION=1

# ── V-P3 内循环（ADR-0032 §3.2；D4 实测标定：120s=五 agent 全体无感区间）──
export BLADEX_INNER_LOOP_BUDGET_S="120"
export BLADEX_INNER_LOOP_MAX_ROUNDS="6"

# ── MQ-A10 agent 注册表缓存（origin_key→agent 绑定 + 待认领桶，跨重启恢复）──
#    落盘位置：<部署根>/data/agent_registry.json。它是**缓存不是真相源**——
#    归属的真相在每条 Turn 自己的 agent_id 上，丢了只会退回 unknown，不丢数据。
#    TTL 的意义：origin_key 粒度较粗（UA+vendor），绑定放久了可能与现实脱节，
#    过期即忘 —— 宁可 unknown，不可误署名。0 = 永不过期。
export BLADEX_AGENT_REGISTRY_TTL_DAYS="7"

# ── 账本档位策略（Jason 2026-08-26 拍板：把选择权交给用户）──
#
#   auto            系统默认规则 = {medium, strong}  ← 当前值，见下方"依据"
#   all             所有档位都强制注入账本面
#   none            都不强制（只保留"已有账本就注只读正文"）
#   medium,strong   显式列出要强制的档位（与 auto 等价）
#   strong          只有 strong 档强制
#
# **集合内** = 强制注入：给工具面 + 首步指令，模型可创建/切换/更新账本。
# **集合外** = 有账本就注**只读正文**（看得见 Goal/Core/Verified，但不被要求去改）、
#              没账本什么都不注。
#
# 🔴 auto 的当前依据（2026-08-26 更新，**已有读数**）：
#
#    ADR-0032 原写"weak 档模型工具调用不可靠"，那是立卡时的**假设**。
#    2026-08-26 用 Pi（恒判 weak）配 all 实测，判据事前写死、事后未改：
#
#        调用率      3/7 = 43%    （判据 ≥30%）  ✅
#        参数正确率  100%          （判据 ≥90%）  ✅  真实工具错误 0
#        误调用率    0             两轮任务不同，各开一张卡是正确判断
#
#    产出质量也超预期：`verified` 段有具体事实（"当前 pi 版本 0.84.2，已是最新"），
#    `ledger_update` 在开卡之后仍被调用 —— MQ-L2（账本只记计划不记结果）
#    第一次在 weak 档上被打破。**假设已被证伪。**
#
#    ⚠️ 但 **auto 在 0.1.0 保持 {medium, strong} 不变**（Jason 2026-08-26 拍板：
#    0.1.0 目标是跑通，优化放 0.2.0）。所以这是一个**已知的保守默认**，不是未验证的默认：
#      · 想让 weak 档也建账本 → 现在就把本项设成 all（已验证可用）
#      · auto 的默认值改不改、什么时候改 → 0.2.0 决定
#
#    代价照旧存在：Pi 21/21 轮判 weak ⇒ auto 档下账本机制对它不可达（台账 MQ-L6）。
#
# 注：dsh **不受本配置影响**——它是按 agent 排除（工具只能从 run_code 程序内调，
#     直呼形态无效），配成 all 也拿不到账本面，其专项形态另立卡。
#
# 🔴 2026-08-30 语义收窄（Jason 拍板"按工具族拆"）：**本项只管账本族**——
#    账本三工具（read/update/switch）+ 首步指令。`bladex_memory_search`
#    **不受它管、始终注入**：同日砍掉 Memory Index 主动注入之后，它成了模型
#    取记忆的唯一通道，按档位关掉它就不是"这件事需不需要账本"的策略问题了
#    （本项的立卡理由说的也一直是账本）。
#    受影响的是 weak 档：以前它整个工具面都没有，现在拿得到记忆搜索、
#    仍拿不到账本工具与首步指令（auto 语义不变）。
#    `none` 的语义**保持不变**：账本面整个关掉（记忆搜索仍在）。
export BLADEX_LEDGER_TIERS="auto"

# ── V-L2/L4 账本激活（ADR-0032 §4.3/§4.4）──
# 切换防抖：同一 session 内距上次落定切换不足 N **用户轮**的再切换拒绝。
# 轮的单位 = role=user 消息数（E0.2 / MQ-L48，2026-09-06 起）：编程 agent 每个工具调用是
# 一次独立请求，按请求数计 3 轮 ≈ 3 个 bash 调用、防抖等于没有；工具往返现在不计。
# 跨 session 不判（新会话/压缩后计数归零，不是抖动，MQ-L44）。默认值待 E2 读数标定。
export BLADEX_LEDGER_SWITCH_DEBOUNCE="3"
# 在同一本账本上过了这么多**用户轮**（同上口径）却没有一次 bladex_ledger_update ⇒
# 注入块尾部附一条陈旧提示（只陈述事实 + 指路，不替模型写内容）。0 = 关。
# 口径是"这本账本上的用户轮次"，不是墙钟——放着两小时可能只是没干活，不是陈旧。
# 计数在 proxy 进程内，重启归零：**只会漏报不会误报**（对刚更新过的账本喊陈旧
# 会让模型去怀疑正确的状态，比不喊更有害）。
export BLADEX_LEDGER_STALE_TURNS="20"

# ── V-P3 内循环 keepalive（ADR-0032 §3.2）──
# 纯 bladex 调用走内循环时客户端会**两段静默**：上游流的 bladex_* 事件被剥掉不转发，
# 内循环本身又在 await 上。2026-08-27 live：Codex 23 秒零字节后判超时断开
# （内循环其实跑成功了，人没等到）。心跳 = SSE 注释行，三协议通吃、语义惰性。
# 0 = 关（回归通道）。
export BLADEX_STREAM_KEEPALIVE_S="10"

# ── 拼接条目老化轮数（V-P4 硬点 1 / ADR-0032 §10-2）──────────────────────
# 混合调用被剥离的 bladex 结果，在拼接表里保留多少轮后退出。
# 0 = 不老化（默认）。ADR §10-2 拍板"不预定默认值、真实流量标定"——
# 这一项给的是**旋钮**不是建议值，等读数出来再定。
# 代价：条目退出会让转发前缀一次性变化 ⇒ 上游 prompt cache 破裂一次。
export BLADEX_SPLICE_MAX_AGE_TURNS="0"

# ── V-L6 账本模板（用户可编辑 config/ledger-template.md 定制新账本段结构；
#    也可用本变量指到别处；空/缺失回退内置模板）──
# export BLADEX_LEDGER_TEMPLATE="config/ledger-template.md"

# ── V-P6 BladeX 自我介绍（稳定层，ADR-0032 §3.1）──
# 目录里放 AGENT.md / TOOLS.md / SKILLS.md，按此顺序拼接后注入**前缀**
# （逐字恒定 ⇒ 吃得到上游 prompt cache；账本块反过来注末尾，见 MQ-L10）。
# 只在**给了工具面时**才注：AGENT/TOOLS 通篇在讲 call bladex_*，没工具就是
# 有令无器、纯注意力税（MQ-L7 同一条理由）。三份全缺 ⇒ 整块不注，无兜底文本
# ——一段错的自我介绍比没有更糟。改内容需重启生效（同模板语义）。
# export BLADEX_SYSTEM_NOTES_DIR="config/system"
#
# ── 注入双通道归属表（ADR-0032 §3.1；V-F3 收口，2026-08-28）──────────────
# 稳定层（system 前缀，会话冻结，改文件重启生效）：
#   AGENT.md / TOOLS.md / SKILLS.md（config/system/，V-P6）
#   AGENTS.md 名册（flash daemon 物化，BLADEX_MODULE_FLASH=1 时并入 about 块）
#   bladex_* 工具定义（toolface，追加 tools 末尾不重排）
# 动态层（消息末尾/末条 user 前，每轮重算）：
#   账本正文+首步指令 / LEDGERS top-5（ledger 块） / 记忆召回（<bladex-memory>）
#   MATTERS 列表 —— gate 在账本↔Matter 绑定（V-L5）落地后（V-F4 开闸）

# ── V-L5 账本锚归属层（ADR-0032 §4.5）──
# 有账本的轮次按"这一轮发生时激活的是哪本账本"归属（点时查找），Matter id 由
# ledger_id 确定性派生；无账本流量照走 D1/五层兜底。开了看日志
# `index_ledger_anchor` 的 **anchored**（不是 bindings —— 后者是表大小，
# MQ-L14 期间它一直非零而真实命中是 0）。
# 默认开（2026-09-02 按 4a/4b 口径签收翻默认）；=0 是回滚通道（零 ANCHOR 边）。
export BLADEX_LEDGER_ANCHOR="1"

# ── V-P3 硬点 8：拦截播报（内循环期间播报 BladeX 在做什么）──
# 🔴 默认关：协议事件序列尚未经真实客户端验证（2026-08-27 第一版不合协议，
# Codex 一次请求即断）。关掉 = 退回 SSE 注释行心跳（已验证形态）。
export BLADEX_NARRATE_INTERCEPT="0"

# ── MQ-L21：agent 自带零工具的请求不给账本面 ──
# 客户端的内部功能调用（标题生成/建议生成之类）通常不带任何工具——它要的是
# 一段文本。给它账本工具会让它建出占位账本，把用户的真实任务从激活位挤掉。
# 0 = 回滚（这类请求照旧拿到工具面）。
export BLADEX_LEDGER_REQUIRE_TOOLS="1"

# ── V-A6 Embedding 独立模块（IPC + hot/bulk 优先级队列）──
# backend=ipc 时 proxy 与 consolidator 都经 IPC 调 `bladex-embed`（默认仍是既有档位，
# 验证后再翻默认）。传输在**启动时决断一次**、打进日志，改动需重启。
# export BLADEX_EMBED_BACKEND="ipc"
# auto（默认）判定序：显式 > 非 POSIX/容器 → tcp > uds
export BLADEX_EMBED_TRANSPORT="auto"
# uds 默认 <部署根>/run/embed.sock；tcp 默认 127.0.0.1:38081
# export BLADEX_EMBED_ADDRESS=""
# bulk 切片大小 = 让路粒度（调大 hot 等待变长，调小批处理效率下降）
export BLADEX_EMBED_BULK_SLICE="64"
# V-A6 模块开关（开=embedding 走独立模块；默认关，翻默认需 MQ-W8 病例复测）
# BLADEX_MODULE_EMBED=0

# ═══════════════════════════════════════════
# 仪器（C1 2026-09-03 三档重排：机制开关 / 标定值 / **仪器**）
# ═══════════════════════════════════════════
# 下面这些开关**不是产品功能**：默认值就是生产形态，改它们只为做 A/B 对照或止血。
# 正文里不再出现（真身与档位登记在 bladex_core/flags.py `FLAG_TIERS`，由测试对账）。
# ── 账本准入闸（ADR-0032 §4.5，2026-09-02）──
# DPL（CONT / L2 / L3 / L4）的边落到**账本锚卡**前过两道因果闸：
#   ① 时间：轮次不得早于账本 created_at（一件事的记录不可能早于它被开立）
#   ② 标签：轮次明确属于别的账本 ⇒ 拒（账本 = 外部任务边界）
# 🔴 默认开（修正确性，不是加特性）。关掉 = 回到 09-02 之前"内容压过账本边界"，
# 兼作 A/B 仪器：关/开各跑一次全量重建，锚卡成员差 = 本闸拦截量。
# 观测：日志 `index_ledger_anchor` 的 gate_other_ledger / gate_before_created。
export BLADEX_LEDGER_GATE="1"
# V-I2 实体键规范化（分隔符变体折叠；=0 退回旧口径做 A/B 或止血）
export BLADEX_ENTITY_CANON="1"
